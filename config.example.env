# Visa Server Configuration
# Copy this file to .env and configure according to your needs

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/visa-server

# Server Configuration
PORT=3000

# Execution Mode Configuration
# EXECUTION_MODE: 'sequential' (recommended) or 'concurrent'
# - sequential: Run countries one by one with delays (more stable, prevents rate limiting)
# - concurrent: Run countries in small batches (faster but may trigger anti-bot protection)
EXECUTION_MODE=sequential

# Concurrent Mode Settings (only used when EXECUTION_MODE=concurrent)
# CONCURRENT_BATCH_SIZE: How many countries to run simultaneously (recommended: 2-3)
CONCURRENT_BATCH_SIZE=3

# Timing Configuration
# DELAY_BETWEEN_COUNTRIES: Delay in milliseconds between country initializations (sequential mode)
# Recommended: 8000-15000ms (8-15 seconds) to avoid rate limiting
DELAY_BETWEEN_COUNTRIES=8000

# DELAY_BETWEEN_BATCHES: Delay in milliseconds between batches (concurrent mode)
# Recommended: 15000-30000ms (15-30 seconds) to avoid detection
DELAY_BETWEEN_BATCHES=15000

# Performance Recommendations:
# 1. For stability and to avoid blocking: Use EXECUTION_MODE=sequential with DELAY_BETWEEN_COUNTRIES=10000
# 2. For faster execution (with some risk): Use EXECUTION_MODE=concurrent with CONCURRENT_BATCH_SIZE=2 and DELAY_BETWEEN_BATCHES=20000
# 3. If you get frequent errors, increase the delays or switch to sequential mode
